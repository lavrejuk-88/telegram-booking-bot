# Скопируйте этот файл в .env и заполните своими значениями.
# Файл .env не попадает в git: в нём токен бота.

# Токен от @BotFather
BOT_TOKEN=1234567890:AAAA-your-token-here

# Telegram ID и username специалиста (ID можно узнать у @userinfobot)
MASTER_TG_ID=123456789
MASTER_USERNAME=your_username

# Часовой пояс специалиста и подпись к времени для клиентов
TIMEZONE=Europe/Moscow
TIMEZONE_LABEL=московское

# Шаг записи в минутах и на сколько дней вперёд можно записаться
BOOKING_STEP_MIN=30
BOOKING_HORIZON_DAYS=60

DB_PATH=bot.db
